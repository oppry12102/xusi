# ═══════════════════════════════════════════════════════════════════
# 墟司（xusi）管理面配置 —— 模板
#
# 首次安装：`python -m xusi install` 会自动从本模板拷一份到 etc/xusi.toml，
# 你只需要按需取消 / 修改对应行。所有字段都可选，留空 = 用内置默认。
#
# 重要：本文件不进 git。每台机器的 etc/xusi.toml 都是本地的——这是 Phase 1.2
# 修 id 撞号的根本保证（之前 id 写在本文件里，git pull 会让多台机器撞号）。
# ═══════════════════════════════════════════════════════════════════

# ── 管理面自身的监听地址 ──
# 0.0.0.0 = 对外（局域网浏览器访问管理页）。
# agent 观察台默认只听 127.0.0.1（expose=true 时 0.0.0.0 直通 LAN，谨慎开启）。
[server]
host = "0.0.0.0"
port = 8601

# ── 管理面行为 ──
[manager]
# 版本仓库路径：管理员投放 xuseek-v2-<版本号>.zip 的目录。新建 agent 自动取
# 最新版本作实例私有副本（instances/<id>/xuseek-v2/）。整目录不入 git。
versions_dir = "/home/ubuntu/work/xusi/versions"

# agent 端口分配段（8601 是管理面，agent 从 8602 起按需占用）
port_range = [8602, 8699]

# 给用户展示用的时区
display_timezone = "Asia/Shanghai"

# ── 双运行时（agent 两种跑法：systemd 直跑 / docker 容器，见
#    docs/container-runtime.md）──
# 新建 agent 的缺省运行时（创建对话框预选此值，可逐次覆盖）：
#   systemd = 系统进程（默认，systemd --user 瞬态单元）
#   docker  = 容器（host 网络；需内核 ≥ v2.7.19 + docker 环境）
default_runtime = "systemd"

# docker 镜像构建/运行时的 PyPI 镜像（仅 docker 运行时生效）：
#   不写此行 = 内置默认（清华镜像）；空串 "" = 关闭镜像走 pypi.org
# docker_pip_index = "https://pypi.tuna.tsinghua.edu.cn/simple"
# 可选：debian 源镜像（大陆网络构建慢时，如 mirrors.tencentyun.com；仅构建期生效）
# docker_apt_mirror = ""
# 可选：能力包名（如 amem），构建期烘培其重依赖进镜像（体积大，按需开）
# docker_extras = ""

# ── 缺省根智能体（可选，v2.7.12+ 内核互联）──
# 新建 agent 时创建对话框预填这些根（可删改）；address/token 齐备才生效。
# [[default_roots]]
# address = "https://root.example.com:8400"
# token = "rt-…"

# ── admin token ──
# 管理面唯一的凭证：所有 /api/* 的鉴权。留空 = 未初始化（xusi init 生成）。
[admin]
# secret = "请用 openssl rand -hex 32 生成"

# ── 节点身份 ──
# 不写在这里——节点身份写到 etc/node.id（单行 URL-safe 8 字节；gitignored、
# 600；不可改）。load_config 首次启动自动生成。临时覆盖用环境变量 XUSI_NODE_ID。
# 历史：Phase 1 曾把 id 写进 toml，git pull 会撞号；Phase 1.2 改读 /etc/machine-id
# 仍不够（VM/容器克隆会复制 machine-id），现改为本地生成。
