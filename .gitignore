# ═══ 密钥与运行时数据 —— 永不入库 ═══
# 管理面本地配置（端口、源路径、role 等；每台机器独立——git pull 会撞配置）
etc/xusi.toml
# 四家 LLM 的 api_key（用 brains.toml.example 起手）
etc/brains.toml
# 管理面 token（admin/user）
etc/tokens.json
# 注册表（含各 agent 的观察台 token）
etc/agents.json
# 管理操作审计
etc/audit.jsonl
# agent 实例目录（config.toml 含 key、data/ 含 token 与会话）
instances/
# xuseek-v2 源码（自管副本：部署时从 GitHub 拉取，见 etc/xusi.toml source_repo）
xuseek-v2/
# 版本仓库整目录不入库（zip 含私有源码 xuseek-v2；约定文档在 docs/versions.md）
versions/

# ═══ 环境与杂物 ═══
.venv/
__pycache__/
*.pyc
*.tmp
etc/backups/
