# ═══ 密钥与运行时数据 —— 永不入库 ═══
# 管理面本地配置（端口、源路径、role 等；每台机器独立——git pull 会撞配置）
etc/xusi.toml
# 历史残留：v2 已删对等互联（peers.py），旧文件防入库
etc/peers.toml
# 节点身份（URL-safe 8 字节；首次 serve 自动生成；每台机器必须独立）
etc/node.id
# 节点显示名（PATCH /api/node 改写；每台机器可能不同；运行时数据）
etc/node.json
# 四家 LLM 的 api_key（用 brains.toml.example 起手）
etc/brains.toml
# 历史残留：v2 已删反代（/px /svc）与反代 token，旧文件防入库
etc/tokens.json
# 历史残留：v2.2 已删 mailroom，其 outbox 扫描偏移旧状态文件防入库
etc/outbox_state.json
# 独立工作区（amem 共享锁实验等，与本仓无关、体积大，永不入库）
shared/
# 历史残留：v2 已删互联 token 签发（互联改由 agent 自签、经管理邮箱发布）
etc/inter_agent_tokens.json
# 注册表（agent 簿记 + 期望态 + 互联标注，含 agent 发布的互联 token 明文）
etc/agents.json
# 管理操作审计
etc/audit.jsonl
# 远端机器清单（控制端 fan-out：SSH 密码先明文——600 权限但绝不入库）
etc/hosts.toml
# 注册表跨进程 flock 载体（运行时自建，内容无意义）
etc/.registry.lock
# 链路竞速结果缓存（per-host 当选链路 + 时间戳，无敏感字段）
etc/link_cache.json
# 远端备份拉回目录（remote backup 的落点）
etc/remote-backups/
# agent 实例目录（config.toml 含 key、data/ 含 token 与会话）
instances/
# xuseek-v2 源码（自管副本：部署时从 GitHub 拉取，见 etc/xusi.toml source_repo）
xuseek-v2/
# 版本仓库整目录不入库（zip 含私有源码 xuseek-v2；约定文档在 docs/versions.md）
versions/

# ═══ 环境与杂物 ═══
.venv/
__pycache__/
*.pyc
*.tmp
etc/backups/
# Claude Code harness 配置（本地权限/项目记忆；每台机器独立）
.claude/
# 旧 token 轮换时被改名留底的废弃文件（含明文凭证，永不入库）
etc/*.deprecated.*
